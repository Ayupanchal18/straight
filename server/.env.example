# Server & Environment Config
PORT=5000
NODE_ENV=production

# Database (Optional - App falls back cleanly to in-memory caching if omitted)
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/crickethub?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/crickethub

# CORS Configuration
CORS_ORIGIN=*

# Cache TTLs (in seconds)
CACHE_TTL_LIVE=30
CACHE_TTL_SCHEDULE=3600
CACHE_TTL_PLAYERS=86400

# Rate Limiting
RATE_LIMIT_MAX=300
